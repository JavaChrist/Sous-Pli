APP_PUBLIC_URL=http://127.0.0.1:3000
STORAGE_BUCKET=sous-pli-local.appspot.com
# MOLLIE_API_KEY=live_... ou test_...
# MOLLIE_WEBHOOK_URL=https://europe-west1-PROJET.cloudfunctions.net/mollieWebhook
# MOLLIE_OPERATOR_UIDS=uid-habilite
# Une clé live_ encaisse un paiement réel. Une clé test_ ouvre Mollie sans débit réel.
# Une clé test_ ouvre Mollie, y compris avec APP_PUBLIC_URL en http://127.0.0.1:3000.
# Sans URL de webhook https, la confirmation se fait au retour, en relisant l'API Mollie.
# RETENTION_APPLY=true active les suppressions. Sans cette valeur, le traitement reste en simulation.
# MAIL_FROM_ADDRESS=
# RESEND_API_KEY=
# Les e-mails de compte (mot de passe, vérification, changement d'adresse, suppression)
# partent par cette file, avec un code d'action Firebase. Ne pas activer en plus
# l'e-mail standard Firebase pour la même action.
# APP_PUBLIC_URL doit être une origine autorisée dans Firebase Authentication.
# ENFORCE_APP_CHECK=false
# Achats Play. Valeur absente ou autre que test/public : personne ne peut ouvrir un achat.
# test : seulement les UID listés. public : après validation des testeurs de licence.
# Pas de clé JSON : les Functions utilisent l'identité d'exécution et les identifiants par défaut.
# PLAY_PURCHASE_ACCESS=test
# PLAY_TEST_UIDS=uid-du-compte-de-test
# URL exacte de playDeveloperNotification, identique à l'audience du jeton Pub/Sub.
# PLAY_RTDN_AUDIENCE=
# Si vide, l'appelant attendu est le compte d'exécution des Functions.
# PLAY_RTDN_PUSH_EMAIL=
