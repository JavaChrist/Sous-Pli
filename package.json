{
  "name": "sous-pli",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/write-version.mjs && npm run build:functions && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project sous-pli-local \"npx vitest run --fileParallelism false tests/rules.test.ts tests/storage.rules.test.ts\"",
    "build:functions": "esbuild functions/src/index.ts --bundle --platform=node --target=node22 --outfile=functions/lib/index.js --format=cjs --external:firebase-admin --external:firebase-functions --sourcemap",
    "emulators": "npm run build:functions && node scripts/start-emulators.mjs",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^13.1.0",
    "lucide-react": "^1.7.0",
    "next": "^16.4.2",
    "papaparse": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "read-excel-file": "^9.3.12",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
