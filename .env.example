# Valeurs de démonstration pour les émulateurs. Ne pas y placer de secret Admin,
# de clé privée, de jeton SMTP ni de clé d'API de messagerie.

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sous-pli-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sous-pli-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sous-pli-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:local

# true : Auth, Firestore, Functions, Storage locaux.
NEXT_PUBLIC_USE_EMULATORS=true

# Laisser vide en local. En production, clé de site reCAPTCHA Enterprise / v3 pour App Check.
NEXT_PUBLIC_APPCHECK_SITE_KEY=

# Jeton de débogage App Check, uniquement sur un poste de développement.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Enregistrer le service worker aussi en développement (désactivé par défaut).
NEXT_PUBLIC_ENABLE_SW=false

# Réservé au serveur de fonctions (jamais NEXT_PUBLIC_).
# MAIL_FROM_ADDRESS=noreply@exemple.fr
# MAIL_FROM_DOMAIN=exemple.fr
# RESEND_API_KEY=
# ENFORCE_APP_CHECK=false
