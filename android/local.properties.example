# Fichier ignoré par git. Ne pas y mettre de clé de signature.
# RELEASE_SIGNING_FILE pointe vers un fichier hors dépôt :
# storeFile, keyAlias, storePassword, keyPassword.
# RELEASE_SIGNING_FILE=
# sdk.dir est ajouté par Android Studio ou par la compilation locale.
#
# Identifiant OAuth de type client Web du même projet Firebase que le site.
# Il sert uniquement à Credential Manager. Ne pas inventer cette valeur.
GOOGLE_WEB_CLIENT_ID=
# Jeton court pour ouvrir une prévisualisation protégée. Ne pas le commiter.
# VERCEL_PROTECTION_HEADER=
#
# Trois cibles distinctes. Le site public n'est utilisé que sans CAPACITOR_USE_DEBUG_SERVER.
# CAPACITOR_DEBUG_TARGET=local
# CAPACITOR_LOCAL_URL=http://10.0.2.2:3010
# CAPACITOR_PREVIEW_URL=https://exemple.vercel.app
